# ── LLM Provider ────────────────────────────────────────────────────────────
# groq | openai | azure | anthropic | ollama
LLM_PROVIDER=groq

# Groq (default)
GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL=llama-3.3-70b-versatile

# OpenAI (when LLM_PROVIDER=openai)
# OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# Azure OpenAI (when LLM_PROVIDER=azure)
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o-mini
# AZURE_OPENAI_API_VERSION=2024-08-01-preview
# AZURE_TENANT_ID=...
# AZURE_CLIENT_ID=...
# AZURE_CLIENT_SECRET=...

# Anthropic (when LLM_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-3-5-haiku-20241022

# Ollama / self-hosted (when LLM_PROVIDER=ollama)
# OLLAMA_BASE_URL=http://localhost:11434
# LLM_MODEL=llama3.2

# ── Memory (LangMem — LangGraph AsyncPostgresStore + pgvector) ───────────────
MEMORY_ENABLED=true

# OpenAI API key — used by LangMem for embeddings (text-embedding-3-small)
OPENAI_API_KEY=sk-...

# PostgreSQL backing store for LangMem (docker-compose service: langmem_postgres)
LANGMEM_POSTGRES_PASSWORD=langmemsecretpw

# ── API Security ──────────────────────────────────────────────────────────────
# Set to a secret string; all requests must include header: X-Api-Key: <value>
# Leave blank to disable auth (dev/internal use only)
API_KEY=

# ── Server ────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
CORS_ORIGINS=["*"]
